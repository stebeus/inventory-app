<!doctype html>
<html lang="en">
	<%- include('partials/metadata', locals.title) %>
	<body>
		<div id="root" class="center-xy">
			<%- include('partials/navbar') %>
			<main class="border-outset container">
				<form class="form flex stack" action="/<%= action %>" method="post">
					<h1><%= locals.title %></h1>

					<% if (locals.errors != null) {%>
						<ul class="errors">
							<% for (const { message } of errors) { %>
								<li class="error"><%= message %></li>
							<% } %>
						</ul>
					<% } %>

						<%- include('partials/forms/input-field', {
							label: 'Name',
							name: 'name',
							type: 'text',
							value: locals.values.name,
						}) %>

						<% if (locals.hasDescription) { %>
							<%-	include('partials/forms/textarea-field', {
								label: 'Description',
								name: 'description',
								value: locals.values.description
							}) %>
						<% } %>

						<%-	include('partials/forms/input-field', {
							label: 'Image link',
							name: 'imgUrl',
							type: 'url',
							value: locals.values.imgUrl,
							placeholder:'https://site.com/image_name.png',
						}) %>

					<button class="button text-inverted text-shadow" type="submit">Submit</button>
				</form>
			</main>
			<%- include('partials/footer') %>
		</div>
	</body>
</html>
