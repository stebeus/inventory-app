<!doctype html>
<html lang="en">
	<%- include('partials/metadata', locals.title) %>
	<body>
		<div id="root" class="center-xy flex stack">
			<%- include('partials/navbar') %>
			<main class="flex stack">
				<%- include('partials/tabs', { route: 'manage-categories' }) %>

				<section class="border-outset center-xy container flex position-relative stack">
					<div class="info center-xy flex stack">
						<img
							class="border-inset"
							src="<%= category.imgUrl %>"
							alt=""
							width="128"
							height="128"
						>
						<h1><%= category.name %></h1>
						<p>Item quantity: <%= itemCount %></p>
					</div>

					<ul class="actions flex flex-wrap">
						<li class="action">
							<%- include('partials/button-link', {
								href: `/create-item/${category.id}`,
								label: 'Create item',
							}) %>
						</li>
						<li class="action">
							<%- include('partials/button-link', {
								href: `/edit-category/${category.id}`,
								label: 'Edit category',
							}) %>
						</li>

						<% if (parseInt(category.id) !== 1) { %>
							<li class="action">
								<%- include('partials/forms/delete-button', {
									action: `/delete-category/${category.id}`,
									label: 'Delete category',
								}) %>
							</li>
						<% } %>
					</ul>
				</section>
			</main>
			<%- include('partials/footer') %>
		</div>
	</body>
</html>
