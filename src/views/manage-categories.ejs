<!doctype html>
<html lang="en">
	<%- include('partials/metadata', locals.title) %>
	<body>
		<div id="root">
			<%- include('partials/navbar') %>
			<main>
				<a href="/create-category">Create category</a>

				<%- include('partials/tabs', { route: 'manage-categories' }) %>

				<section class="category">
					<img src="<%= category.imgUrl %>" alt="" width="128" height="128">
					<h3><%= category.name %></h3>
					<p>Item quantity: <%= itemCount %></p>

					<ul class="actions">
						<li class="action">
							<a href="/create-item/<%= category.id %>">Create item</a>
						</li>
						<li class="action">
							<a href="/edit-category/<%= category.id %>">Edit category</a>
						</li>

						<!-- For some reason, Postgres.js gives incorrect value types -->
						<% if (Number(category.id) !== 1) { %>
							<li class="action">
								<form
									action="/delete-category/<%= category.id %>"
									method="post"
								>
									<button type="submit">Delete category</button>
								</form>
							</li>
						<% } %>
					</ul>
				</section>
			</main>
			<%- include('partials/footer') %>
		</div>
	</body>
</html>
