<!doctype html>
<html lang="en">
	<%- include('partials/metadata', locals.title) %>
	<body>
		<div id="root">
			<%- include('partials/navbar') %>
			<main>
				<%- include('partials/tabs') %>

				<%- include('partials/forms/search') %>

				<ul class="items">
					<% for (const { id, name, imgUrl } of items) { %>
						<li class="item">
							<%- include('partials/img-link', {
								href: `item/${id}/`,
								name,
								imgUrl,
							}) %>
						</li>
					<% } %>
				</ul>
			</main>
			<%- include('partials/footer') %>
		</div>
	</body>
</html>
