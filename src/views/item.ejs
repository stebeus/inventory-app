<!doctype html>
<html lang="en">
	<%- include('partials/metadata', locals.title) %>
	<body>
		<div id="root" class="center-xy">
			<%- include('partials/navbar') %>
			<main class="border-outset center-xy container flex stack">
				<div class="info center-xy flex stack">
					<img
						class="border-inset"
						src="<%= item.imgUrl %>"
						alt=""
						width="128"
						height="128"
					/>
					<h1><%= item.name %></h1>
					<p><%= item.description %></p>
				</div>

				<ul class="actions flex flex-wrap">
					<li class="action">
						<%- include('partials/button-link', {
							href: `/edit-item/${categoryId}/${item.id}`,
							label: 'Edit item',
						}) %>
					</li>
					<li class="action">
						<%- include('partials/forms/delete-button', {
							action: `/delete-item/${categoryId}/${item.id}`,
							label: 'Delete item',
						}) %>
					</li>
				</ul>
			</main>
			<%- include('partials/footer') %>
		</div>
	</body>
</html>
