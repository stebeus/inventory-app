<!doctype html>
<html lang="en">
	<%- include('partials/metadata', locals.title) %>
	<body>
		<div id="root">
			<%- include('partials/navbar') %>
			<main>
				<img src="<%= item.imgUrl %>" alt="" width="128" height="128" />
				<h2><%= item.name %></h2>
				<p><%= item.description %></p>

				<ul class="actions">
					<li class="action">
						<a href="/edit-item/<%= item.id %>">Edit item</a>
					</li>
					<li class="action">
						<form
							action="/delete-item/<%= categoryId %>/<%= item.id %>"
							method="post"
						>
							<button type="submit">Delete item</button>
						</form>
					</li>
				</ul>
			</main>
			<%- include('partials/footer') %>
		</div>
	</body>
</html>
